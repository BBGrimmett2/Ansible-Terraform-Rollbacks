# Example Terraform variables file
# Copy this to terraform.tfvars and customize as needed

aws_region        = "us-east-1"
vpc_cidr          = "10.0.0.0/16"
subnet_cidr       = "10.0.1.0/24"
instance_type     = "t3.micro"
instance_name     = "terraform-rollback-demo"
allowed_ssh_cidrs = ["0.0.0.0/0"]  # WARNING: Restrict this in production

# Demo failure simulation
simulate_tf_failure = false  # Set to true to test Terraform failure rollback
